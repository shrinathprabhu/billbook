{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "billbook",
  "compatibility_date": "2026-09-01",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "billbook.lowkey.tools", "custom_domain": true }],
  "assets": {
    "directory": "../../dist/workers",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
